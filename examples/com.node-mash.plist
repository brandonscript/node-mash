<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.node-mash</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/ABSOLUTE/PATH/TO/python3</string>
		<string>/ABSOLUTE/PATH/TO/node_mash.py</string>
		<string>service</string>
		<string>/ABSOLUTE/PATH/TO/PROJECTS</string>
		<string>--once</string>
		<string>--days</string>
		<string>180</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/ABSOLUTE/PATH/TO/LOGS/node-mash.error.log</string>
	<key>StandardOutPath</key>
	<string>/ABSOLUTE/PATH/TO/LOGS/node-mash.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
</dict>
</plist>
